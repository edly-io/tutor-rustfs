# Init/admin job container.
#
# Runs the init logic (bucket creation + anonymous read policy) from
# `rc`, RustFS's own S3-compatible CLI image. The RustFS server image
# does not ship a client itself.
#
# The service name must be `<service>-job`, where `<service>` is the
# name registered with CLI_DO_INIT_TASKS in plugin.py — Tutor appends
# the `-job` suffix when it resolves the task.
rustfs-job:
  image: {{ RUSTFS_RC_DOCKER_IMAGE }}
  entrypoint: []
  depends_on: ["rustfs"]
